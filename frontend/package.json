{
  "name": "playwright-login-automation-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:fast": "next dev",
    "prebuild": "node scripts/check-dev-stopped.mjs",
